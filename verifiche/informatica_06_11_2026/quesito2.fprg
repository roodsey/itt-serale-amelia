<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="quesito2"/>
        <attribute name="authors" value="Utente"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-11-06 07:01:22 "/>
        <attribute name="created" value="VXRlbnRlO1BDLURPQ0VOVEUtUEFDSTsyMDI2LTExLTA2OyIwNjoxNTowMiAiOzI4NTI="/>
        <attribute name="edited" value="VXRlbnRlO1BDLURPQ0VOVEUtUEFDSTsyMDI2LTExLTA2OyIwNzowMToyMiAiOzM7Mjk2MA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="fattore1, fattore2, prodotto, contatore" type="Integer" array="False" size=""/>
            <input variable="fattore1"/>
            <input variable="fattore2"/>
            <assign variable="prodotto" expression="0"/>
            <for variable="contatore" start="1" end="fattore2" direction="inc" step="1">
                <assign variable="prodotto" expression="prodotto + fattore1"/>
            </for>
            <output expression="&quot;Prodotto = &quot; &amp; fattore1 &amp; &quot; * &quot; &amp; fattore2 &amp; &quot; = &quot; &amp; prodotto" newline="True"/>
        </body>
    </function>
</flowgorithm>
