<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="multiplo_scambio"/>
        <attribute name="authors" value="marco.ruzzi"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-06 08:24:45 "/>
        <attribute name="created" value="bWFyY28ucnV6emk7REVTS1RPUC1CSjdUOExWOzIwMjYtMTAtMDY7IjA4OjAxOjMzICI7MzQyMw=="/>
        <attribute name="edited" value="bWFyY28ucnV6emk7REVTS1RPUC1CSjdUOExWOzIwMjYtMTAtMDY7IjA4OjI0OjQ1ICI7MTszNTM5"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n1, n2" type="Integer" array="False" size=""/>
            <output expression="&quot;Inserisci n1: &quot;" newline="True"/>
            <input variable="n1"/>
            <output expression="&quot;Inserisci n2: &quot;" newline="True"/>
            <input variable="n2"/>
            <if expression="n1 &lt; n2">
                <then>
                    <output expression="n1 &amp; &quot; &#232; minore di &quot; &amp; n2 &amp; &quot;! Inverto i due numeri!&quot;" newline="True"/>
                    <declare name="temp" type="Integer" array="False" size=""/>
                    <assign variable="temp" expression="n1"/>
                    <assign variable="n1" expression="n2"/>
                    <assign variable="n2" expression="temp"/>
                </then>
                <else/>
            </if>
            <if expression="n1 % n2 = 0">
                <then>
                    <output expression="n1 &amp; &quot; &#232; multiplo di &quot; &amp; n2" newline="True"/>
                </then>
                <else>
                    <output expression="n1 &amp; &quot; non &#232; multiplo di &quot; &amp; n2" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
