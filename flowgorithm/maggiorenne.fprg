    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="eta" type="Integer" array="False" size=""/>
            <output expression="&quot;Inserisci il valore dell'eta': &quot;" newline="True"/>
            <input variable="eta"/>
            <if expression="eta &gt;= 18">
                <then>
                    <output expression="&quot;Una persona di eta' &quot; &amp; eta &amp; &quot; e' maggiorenne&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Una persona di eta' &quot; &amp; eta &amp; &quot; e' minorenne&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
