<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="primo"/>
        <attribute name="authors" value="marco.ruzzi"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-15 05:47:03 "/>
        <attribute name="created" value="bWFyY28ucnV6emk7REVTS1RPUC1VQ0FEOElDOzIwMjYtMTAtMTU7IjA1OjE0OjM3ICI7MzQxMg=="/>
        <attribute name="edited" value="bWFyY28ucnV6emk7REVTS1RPUC1VQ0FEOElDOzIwMjYtMTAtMTU7IjA1OjQ3OjAzICI7MjszNTIw"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero, contatore" type="Integer" array="False" size=""/>
            <output expression="&quot;Inserisci un numero intero&quot;" newline="True"/>
            <input variable="numero"/>
            <assign variable="contatore" expression="2"/>
            <declare name="estPrimo" type="Boolean" array="False" size=""/>
            <assign variable="estPrimo" expression="true"/>
            <while expression="contatore &lt; numero">
                <if expression="numero % contatore = 0">
                    <then>
                        <assign variable="estPrimo" expression="false"/>
                        <output expression="&quot;il numero &quot; &amp; numero &amp; &quot; &#232; divisibile per &quot; &amp; contatore" newline="True"/>
                    </then>
                    <else/>
                </if>
                <assign variable="contatore" expression="contatore + 1"/>
            </while>
            <if expression="estPrimo">
                <then>
                    <output expression="numero &amp; &quot; &#232; numero PRIMO!&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="numero &amp; &quot; NON &#232; numero PRIMO!&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
