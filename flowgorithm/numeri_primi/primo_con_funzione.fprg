<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="primo_con_funzione"/>
        <attribute name="authors" value="marco.ruzzi"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-23 01:00:39 "/>
        <attribute name="created" value="bWFyY28ucnV6emk7REVTS1RPUC1VQ0FEOElDOzIwMjYtMTAtMjM7IjEyOjUzOjUzICI7MzQxMA=="/>
        <attribute name="edited" value="bWFyY28ucnV6emk7REVTS1RPUC1VQ0FEOElDOzIwMjYtMTAtMjM7IjAxOjAwOjM5ICI7MTszNTEy"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero" type="Integer" array="False" size=""/>
            <input variable="numero"/>
            <if expression="calcolaDivisori(numero) &gt; 2">
                <then>
                    <output expression="numero &amp; &quot; non &#232; PRIMO!&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="numero &amp; &quot; &#232; PRIMO!&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
    <function name="calcolaDivisori" type="Integer" variable="divisori">
        <parameters>
            <parameter name="numero" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="divisori" type="Integer" array="False" size=""/>
            <declare name="conteggio" type="Integer" array="False" size=""/>
            <assign variable="conteggio" expression="1"/>
            <assign variable="divisori" expression="0"/>
            <for variable="conteggio" start="1" end="numero" direction="inc" step="1">
                <if expression="numero % conteggio == 0">
                    <then>
                        <assign variable="divisori" expression="divisori + 1"/>
                    </then>
                    <else/>
                </if>
            </for>
        </body>
    </function>
</flowgorithm>
