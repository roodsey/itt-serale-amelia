<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="definizione_funzioni"/>
        <attribute name="authors" value="marco.ruzzi"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-23 04:31:42 "/>
        <attribute name="created" value="bWFyY28ucnV6emk7REVTS1RPUC1VQ0FEOElDOzIwMjYtMTAtMjM7IjA0OjI1OjU1ICI7MzQxMg=="/>
        <attribute name="edited" value="bWFyY28ucnV6emk7REVTS1RPUC1VQ0FEOElDOzIwMjYtMTAtMjM7IjA0OjMxOjQyICI7MzszNTE1"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero" type="Integer" array="False" size=""/>
            <input variable="numero"/>
            <if expression="estPrimo(numero)">
                <then>
                    <output expression="&quot;il numero &quot; &amp; numero &amp; &quot; &#232; numero PRIMO!&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;il numero &quot; &amp; numero &amp; &quot; NON &#232; numero PRIMO!&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
    <function name="estNumeroPrimo" type="Boolean" variable="estPrimo">
        <parameters>
            <parameter name="numero" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="estPrimo" type="Boolean" array="False" size=""/>
            <declare name="divisori" type="Integer" array="False" size=""/>
            <assign variable="divisori" expression="quantiDivisori(numero)"/>
            <if expression="divisori &lt;= 2">
                <then>
                    <assign variable="estPrimo" expression="true"/>
                </then>
                <else>
                    <assign variable="estPrimo" expression="false"/>
                </else>
            </if>
        </body>
    </function>
    <function name="quantiDivisori" type="Integer" variable="divisori">
        <parameters>
            <parameter name="numero" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="divisori" type="Integer" array="False" size=""/>
            <assign variable="divisori" expression="0"/>
            <declare name="conteggio" type="Integer" array="False" size=""/>
            <for variable="conteggio" start="1" end="numero" direction="inc" step="1">
                <if expression="numero % conteggio == 0">
                    <then>
                        <assign variable="divisori" expression="divisori + 1"/>
                    </then>
                    <else/>
                </if>
            </for>
        </body>
    </function>
</flowgorithm>
