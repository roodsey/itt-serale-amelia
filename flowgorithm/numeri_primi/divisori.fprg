<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="divisori"/>
        <attribute name="authors" value="marco.ruzzi"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-23 12:53:46 "/>
        <attribute name="created" value="bWFyY28ucnV6emk7REVTS1RPUC1VQ0FEOElDOzIwMjYtMTAtMjM7IjEyOjQ0OjU0ICI7MzQxMQ=="/>
        <attribute name="edited" value="bWFyY28ucnV6emk7REVTS1RPUC1VQ0FEOElDOzIwMjYtMTAtMjM7IjEyOjUzOjQ2ICI7MTszNTIw"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero, conteggio, divisori" type="Integer" array="False" size=""/>
            <input variable="numero"/>
            <assign variable="conteggio" expression="1"/>
            <assign variable="divisori" expression="0"/>
            <for variable="conteggio" start="1" end="numero" direction="inc" step="1">
                <if expression="numero % conteggio == 0">
                    <then>
                        <assign variable="divisori" expression="divisori + 1"/>
                    </then>
                    <else/>
                </if>
            </for>
            <output expression="&quot;Ho trovato &quot; &amp; divisori &amp; &quot; divisori per il numero &quot; &amp; numero" newline="True"/>
        </body>
    </function>
</flowgorithm>
