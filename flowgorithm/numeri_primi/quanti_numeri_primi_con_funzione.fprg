<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="quanti_primi"/>
        <attribute name="authors" value="marco.ruzzi"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-23 04:07:09 "/>
        <attribute name="created" value="bWFyY28ucnV6emk7REVTS1RPUC1VQ0FEOElDOzIwMjYtMTAtMjM7IjAxOjA1OjI1ICI7MzQwNA=="/>
        <attribute name="edited" value="bWFyY28ucnV6emk7REVTS1RPUC1VQ0FEOElDOzIwMjYtMTAtMjM7IjA0OjA3OjA5ICI7MzszNTIx"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero, numeroAttuale, quantiPrimi" type="Integer" array="False" size=""/>
            <input variable="numero"/>
            <assign variable="numeroAttuale" expression="1"/>
            <comment text="uso la variabile &quot;numeroAttuale&quot; per memorizzare il valore del numero che sto analizzando per verificare se &#232; un numero primo oppure no"/>
            <assign variable="quantiPrimi" expression="0"/>
            <comment text="uso la variabile &quot;quantiPrimi&quot; per contare i numeri primi che trovo: ogni volte che ne trovo uno incremento la variabile di UNO"/>
            <for variable="numeroAttuale" start="1" end="numero" direction="inc" step="1">
                <if expression="estNumeroPrimo(numeroAttuale)">
                    <then>
                        <output expression="&quot;Ho trovato un numero primo: &quot; &amp; numeroAttuale" newline="True"/>
                        <assign variable="quantiPrimi" expression="quantiPrimi + 1"/>
                    </then>
                    <else/>
                </if>
            </for>
            <output expression="&quot;Ho trovato &quot; &amp; quantiPrimi &amp; &quot; numeri primi fra 1 e &quot; &amp; numero" newline="True"/>
        </body>
    </function>
    <function name="estNumeroPrimo" type="Boolean" variable="estPrimo">
        <parameters>
            <parameter name="numeroDaControllare" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="estPrimo" type="Boolean" array="False" size=""/>
            <declare name="divisori, numeroAttuale" type="Integer" array="False" size=""/>
            <assign variable="divisori" expression="0"/>
            <for variable="numeroAttuale" start="1" end="numeroDaControllare" direction="inc" step="1">
                <if expression="numeroDaControllare % numeroAttuale == 0">
                    <then>
                        <assign variable="divisori" expression="divisori + 1"/>
                    </then>
                    <else/>
                </if>
            </for>
            <if expression="divisori &lt;= 2">
                <then>
                    <assign variable="estPrimo" expression="true"/>
                </then>
                <else>
                    <assign variable="estPrimo" expression="false"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
