<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="quanti_primi"/>
        <attribute name="authors" value="marco.ruzzi"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-23 01:11:40 "/>
        <attribute name="created" value="bWFyY28ucnV6emk7REVTS1RPUC1VQ0FEOElDOzIwMjYtMTAtMjM7IjAxOjA1OjI1ICI7MzQwNA=="/>
        <attribute name="edited" value="bWFyY28ucnV6emk7REVTS1RPUC1VQ0FEOElDOzIwMjYtMTAtMjM7IjAxOjExOjQwICI7MTszNTA2"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero, conteggio, quantiPrimi" type="Integer" array="False" size=""/>
            <input variable="numero"/>
            <assign variable="conteggio" expression="1"/>
            <assign variable="quantiPrimi" expression="0"/>
            <for variable="conteggio" start="1" end="numero" direction="inc" step="1">
                <declare name="numeroAttuale" type="Integer" array="False" size=""/>
                <assign variable="numeroAttuale" expression="conteggio"/>
                <declare name="conteggioDivisori, quantiDivisori" type="Integer" array="False" size=""/>
                <assign variable="conteggioDivisori" expression="1"/>
                <assign variable="quantiDivisori" expression="0"/>
                <for variable="conteggioDivisori" start="1" end="numeroAttuale" direction="inc" step="1">
                    <if expression="numeroAttuale % conteggioDivisori == 0">
                        <then>
                            <assign variable="quantiDivisori" expression="quantiDIvisori + 1"/>
                        </then>
                        <else/>
                    </if>
                    <assign variable="conteggioDivisori" expression="conteggioDivisori + 1"/>
                </for>
                <if expression="quantiDivisori &lt;= 2">
                    <then>
                        <assign variable="quantiPrimi" expression="quantiPrimi + 1"/>
                    </then>
                    <else/>
                </if>
                <assign variable="conteggio" expression="conteggio + 1"/>
            </for>
            <output expression="&quot;Ho trovato &quot; &amp; quantiPrimi &amp; &quot; numeri primi fra 1 e &quot; &amp; numero" newline="True"/>
        </body>
    </function>
</flowgorithm>
