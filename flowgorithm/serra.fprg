    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="temperatura" type="Integer" array="False" size=""/>
            <output expression="&quot;Inserisci il valore della temperatura della serra: &quot;" newline="True"/>
            <input variable="temperatura"/>
            <if expression="temperatura &gt; 18">
                <then>
                    <output expression="&quot;Temperatura normale!&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="termperatura &lt; 5">
                        <then>
                            <output expression="&quot;ATTENZIONE: danni irreparabili!&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;ATTENZIONE: situazione di pericolo!&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
